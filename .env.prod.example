# ============================================================================
# V-SAT COMPASS - MẪU BIẾN MÔI TRƯỜNG CHO LINUX HOME SERVER (PRODUCTION)
# ============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env trên server: cp .env.prod.example .env
# 2. Thay thế toàn bộ các giá trị placeholder bằng thông tin bảo mật thật.
# 3. Phân quyền chặt chẽ trên host: chmod 600 .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Cơ sở dữ liệu PostgreSQL 17
# ----------------------------------------------------------------------------
POSTGRES_DB=vsat_compass
POSTGRES_USER=vsat_prod_user
# Mật khẩu PostgreSQL mạnh (tối thiểu 32 ký tự, không dùng mật khẩu mặc định)
DB_PASSWORD=Thay_Bang_Mat_Khau_Postgres_32_Ky_Tu_Ngau_Nhien_2026!

# Kích thước HikariCP connection pool cho Home Server (tối ưu: 25)
DB_POOL_MAX_SIZE=25

# ----------------------------------------------------------------------------
# 2. Backend Spring Boot & Xác thực JWT
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# Chuỗi bí mật ký JWT 256-bit chuẩn Base64.
# Lệnh sinh trên Linux: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=Thay_Bang_Chuoi_Base64_256bit_Sinh_Tu_OpenSSL

# Thời gian hết hạn Access Token (mặc định 900000 ms = 15 phút)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com,https://vsat.yourdomain.com

# ----------------------------------------------------------------------------
# 3. Bộ nhớ đệm Redis & Tối ưu truy vấn
# ----------------------------------------------------------------------------
CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HEALTH_ENABLED=true
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# Tự động chạy migration Flyway khi khởi động API
FLYWAY_ENABLED=true

# ----------------------------------------------------------------------------
# 4. Trợ lý Trí tuệ Nhân tạo (AI Explain & Review)
# ----------------------------------------------------------------------------
# Khóa API Google Gemini để giải thích câu hỏi và phân tích bài thi
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# 5. Phân hệ Web Admin & CBT (Nginx SPA)
# ----------------------------------------------------------------------------
# Cổng lắng nghe Web Admin trên Home Server (ngầm qua Cloudflare Tunnel)
WEB_PORT=8088

# URL API mà trình duyệt client sẽ gọi đến (qua HTTPS của Cloudflare Tunnel)
VITE_API_URL=https://api.yourdomain.com/api/v1

# ----------------------------------------------------------------------------
# 6. Giám sát & Báo động qua Telegram Bot
# ----------------------------------------------------------------------------
# Token tạo từ @BotFather (ví dụ: 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Chat ID nhận cảnh báo sự cố và báo cáo backup (ví dụ: -1001234567890 hoặc ID cá nhân)
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------------------------
# 7. Tự động hóa Sao lưu (Backup & Disaster Recovery)
# ----------------------------------------------------------------------------
# Thư mục lưu trữ các bản dump .sql.gz trên host
BACKUP_DIR=/opt/vsat-compass/backups

# Số ngày lưu trữ bản backup trước khi tự động xoay vòng xóa cũ
BACKUP_RETENTION_DAYS=14

# Tên remote Rclone đồng bộ đám mây (Google Drive / S3 / OneDrive)
RCLONE_REMOTE=gdrive
